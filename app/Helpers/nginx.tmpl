more_set_headers 'Server: ${CONTAINER_NAME}';

set_real_ip_from  172.17.0.1;
real_ip_header    X-Forwarded-For;

map ${DOLLAR}http_upgrade ${DOLLAR}connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # the port your site will be served on, default_server indicates that this server block
    # is the block to use if no blocks match the server_name
    listen      443 ssl http2 default_server;

    #HEADERS
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Frame-Options "allow-from https://my.uis.edu";
    add_header XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains";
    add_header Content-Security-Policy "default-src * 'unsafe-inline' 'unsafe-eval'; img-src * data:; font-src * data:; object-src 'self'; frame-ancestors 'self' *.uillinois.edu *.uis.edu";

    root        /var/www/laravel/public;
    index       index.php;

    #error_log   /var/log/nginx/error.log debug;
    #access_log /var/log/nginx/access.log with_user_combined;
    error_log syslog:server=127.0.0.1:514,facility=local2,severity=error;
    access_log syslog:server=127.0.0.1:514,facility=local1,severity=info with_user_combined;

    server_name ${APPLICATION_NAME}.apps.uis.edu;
    server_tokens off;

    #SSL
    ssl_certificate /etc/ssl/certs/server_cert.cer;
    ssl_certificate_key /etc/ssl/private/server_key.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers AES256+EECDH:AES256+EDH:AES128+EECDH:AES128+EDH;
    ssl_ecdh_curve secp384r1;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    proxy_pass_request_headers on;
    underscores_in_headers on;
    charset     utf-8;
    # max upload size
    client_max_body_size 75M;   # adjust to taste

    #Nginx 502 Bad Gateway. Solved by increasing buffer
    fastcgi_buffers 16 16k;
    fastcgi_buffer_size 32k;


	location /index.php {
        try_files /not_exists @octane;
    }

    location / {
        try_files ${DOLLAR}uri ${DOLLAR}uri/ @octane;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location @octane {
        set ${DOLLAR}suffix "";

        if (${DOLLAR}uri = /index.php) {
            set ${DOLLAR}suffix ?${DOLLAR}query_string;
        }

        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}http_host;
        proxy_set_header Scheme ${DOLLAR}scheme;
        proxy_set_header SERVER_PORT ${DOLLAR}server_port;
        proxy_set_header REMOTE_ADDR ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
	    proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection ${DOLLAR}connection_upgrade;

        proxy_pass http://127.0.0.1:8000${DOLLAR}suffix;
    }

    location ~ \.php$ {
        set ${DOLLAR}suffix "";

        if (${DOLLAR}uri = /index.php) {
            set ${DOLLAR}suffix ?${DOLLAR}query_string;
        }

        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}http_host;
        proxy_set_header Scheme ${DOLLAR}scheme;
        proxy_set_header SERVER_PORT ${DOLLAR}server_port;
        proxy_set_header REMOTE_ADDR ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
	    proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection ${DOLLAR}connection_upgrade;
        proxy_pass http://127.0.0.1:8000${DOLLAR}suffix;
    }
}